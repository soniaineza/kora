{
  "info": {
    "name": "Kora Africa's Talking API",
    "description": "Postman collection for the Kora SMS/OTP/notification endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001", "type": "string" },
    { "key": "token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Auth (New Modular)",
      "item": [
        {
          "name": "POST /api/auth/send-otp",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/send-otp",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0788123456\",\n  \"fullName\": \"Test User\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/verify-otp",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/verify-otp",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0788123456\",\n  \"code\": \"123456\",\n  \"fullName\": \"Test User\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Auth (Legacy — Web Frontend)",
      "item": [
        {
          "name": "POST /api/otp/send",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/otp/send",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0788123456\"\n}"
            }
          }
        },
        {
          "name": "POST /api/otp/verify",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/otp/verify",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0788123456\",\n  \"code\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "SMS (Protected)",
      "item": [
        {
          "name": "POST /api/sms/send",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/sms/send",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to\": \"0788123456\",\n  \"message\": \"Hello from Kora\",\n  \"from\": \"Kora\"\n}"
            }
          }
        },
        {
          "name": "GET /api/sms/logs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/sms/logs?limit=50&offset=0",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        }
      ]
    },
    {
      "name": "Notifications (Protected)",
      "item": [
        {
          "name": "POST /api/notifications/send — Welcome",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/notifications/send",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"welcome\",\n  \"phone\": \"0788123456\",\n  \"fullName\": \"Alice\"\n}"
            }
          }
        },
        {
          "name": "POST /api/notifications/send — Payment Confirmation",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/notifications/send",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payment_confirmation\",\n  \"phone\": \"0788123456\",\n  \"plan\": \"PREMIUM\",\n  \"amount\": 3000,\n  \"reference\": \"fw_test_123\"\n}"
            }
          }
        },
        {
          "name": "POST /api/notifications/send — Lesson Reminder",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/notifications/send",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"lesson_reminder\",\n  \"phone\": \"0788123456\",\n  \"time\": \"15:00\",\n  \"venue\": \"Kacyiru\"\n}"
            }
          }
        },
        {
          "name": "POST /api/notifications/send — Exam Reminder",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/notifications/send",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"exam_reminder\",\n  \"phone\": \"0788123456\",\n  \"time\": \"2026-08-05 09:00\"\n}"
            }
          }
        },
        {
          "name": "POST /api/notifications/send — Result",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/notifications/send",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"result\",\n  \"phone\": \"0788123456\",\n  \"score\": 18,\n  \"total\": 20,\n  \"passed\": true\n}"
            }
          }
        },
        {
          "name": "GET /api/notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications?limit=50&offset=0",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ]
          }
        }
      ]
    }
  ]
}