# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

JWT_SECRET=

# Server
PORT=5001

# Payments are manual: users place an order and an admin activates it
# in the Admin panel after receiving payment offline. No provider keys needed.
PAYMENT_MODE=demo

# ===== PAYPACK (optional — enables mobile-money payments) =====
# App Key / client_id and secret from the Paypack dashboard (Applications).
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
# Live API: https://payments.paypack.rw/api
PAYPACK_BASE_URL=https://payments.paypack.rw/api
# Webhook signing key — copy "webhook secret" from the Paypack webhook config page.
# Set this in production so inbound webhooks can be verified.
PAYPACK_WEBHOOK_SECRET=
# Must match the webhook mode configured on the Paypack dashboard.
PAYPACK_WEBHOOK_MODE=production

# Africa's Talking (SMS OTP delivery)
# For sandbox: username = "sandbox", use sandbox API key
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Optional: registered sender ID / shortcode (required for production)
AFRICASTALKING_SENDER_ID=

# OTP Settings
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_RESEND_INTERVAL_MS=60000
OTP_SECRET=
DEV_OTP_CODE=123456

# CORS
CORS_ORIGINS=

# Jobs
ENABLE_JOBS=true
