# Frontend API base URL (Vite).
#
# IMPORTANT: leave VITE_API_BASE unset. All API calls go to the same origin
# and are proxied to the backend by vercel.json. Setting it here (or in the
# Vercel dashboard) to a value ending in /api produces double "/api/api/..."
# URLs and breaks every request.
#
# GitHub Pages deployment overrides VITE_API_BASE in the deploy workflow so
# API calls go directly to the Render backend (GitHub Pages has no proxy).

# Public Supabase anon credentials needed at build time (shipped in the bundle
# to every browser). Required or Vite refuses to build (src/lib/supabase.ts).
VITE_SUPABASE_URL=https://diffxypkosxukoxzfsew.supabase.co
